<?xml version="1.0" encoding="UTF-8"?>
<api context="/sns" name="SNSTestAPI" xmlns="http://ws.apache.org/ns/synapse">

    <!--
        Resource 1: POST /publish
        Static configuration — region, topicArn, and credentials are set directly on the mediator.
        Replace the property values below with your own AWS values.
    -->
    <resource methods="POST" uri-template="/publish">
        <inSequence>
            <!-- MessageGroupId is required for FIFO topics -->
            <property name="sns.messageGroupId" value="default-group" scope="default" type="STRING"/>
            <class name="org.wso2.custom.mediator.sns.SNSPublishMediator">
                <!-- CHANGE: your AWS region, e.g. us-east-1 -->
                <property name="region" value="YOUR_AWS_REGION"/>
                <!-- CHANGE: your SNS FIFO topic ARN -->
                <property name="topicArn" value="YOUR_SNS_TOPIC_ARN"/>
                <!-- CHANGE: IAM access key with sns:Publish permission -->
                <property name="accessKeyId" value="YOUR_AWS_ACCESS_KEY_ID"/>
                <!-- CHANGE: IAM secret access key -->
                <property name="secretAccessKey" value="YOUR_AWS_SECRET_ACCESS_KEY"/>
            </class>
            <filter xpath="get-property('sns.status') = 'SUCCESS'">
                <then>
                    <payloadFactory media-type="json">
                        <format>{"status":"SUCCESS","messageId":"$1"}</format>
                        <args>
                            <arg evaluator="xml" expression="get-property('sns.messageId')"/>
                        </args>
                    </payloadFactory>
                    <respond/>
                </then>
                <else>
                    <payloadFactory media-type="json">
                        <format>{"status":"FAILURE","error":"$1"}</format>
                        <args>
                            <arg evaluator="xml" expression="get-property('sns.error')"/>
                        </args>
                    </payloadFactory>
                    <property name="HTTP_SC" scope="axis2" value="500"/>
                    <respond/>
                </else>
            </filter>
        </inSequence>
        <faultSequence>
            <payloadFactory media-type="json">
                <format>{"status":"ERROR","error":"Internal server error"}</format>
            </payloadFactory>
            <property name="HTTP_SC" scope="axis2" value="500"/>
            <respond/>
        </faultSequence>
    </resource>

    <!--
        Resource 2: POST /publish-dynamic?topicArn={arn}&messageGroupId={id}
        Dynamic configuration — topicArn and messageGroupId are passed as query parameters.
        Credentials are still static on the mediator (no topicArn property on the mediator itself).
    -->
    <resource methods="POST" uri-template="/publish-dynamic">
        <inSequence>
            <property expression="$url:topicArn" name="sns.topicArn" scope="default" type="STRING"/>
            <property expression="$url:messageGroupId" name="sns.messageGroupId" scope="default" type="STRING"/>
            <class name="org.wso2.custom.mediator.sns.SNSPublishMediator">
                <!-- CHANGE: your AWS region -->
                <property name="region" value="YOUR_AWS_REGION"/>
                <!-- CHANGE: IAM access key with sns:Publish permission -->
                <property name="accessKeyId" value="YOUR_AWS_ACCESS_KEY_ID"/>
                <!-- CHANGE: IAM secret access key -->
                <property name="secretAccessKey" value="YOUR_AWS_SECRET_ACCESS_KEY"/>
            </class>
            <filter xpath="get-property('sns.status') = 'SUCCESS'">
                <then>
                    <payloadFactory media-type="json">
                        <format>{"status":"SUCCESS","messageId":"$1"}</format>
                        <args>
                            <arg evaluator="xml" expression="get-property('sns.messageId')"/>
                        </args>
                    </payloadFactory>
                    <respond/>
                </then>
                <else>
                    <payloadFactory media-type="json">
                        <format>{"status":"FAILURE","error":"$1"}</format>
                        <args>
                            <arg evaluator="xml" expression="get-property('sns.error')"/>
                        </args>
                    </payloadFactory>
                    <property name="HTTP_SC" scope="axis2" value="500"/>
                    <respond/>
                </else>
            </filter>
        </inSequence>
        <faultSequence>
            <payloadFactory media-type="json">
                <format>{"status":"ERROR","error":"Internal server error"}</format>
            </payloadFactory>
            <property name="HTTP_SC" scope="axis2" value="500"/>
            <respond/>
        </faultSequence>
    </resource>

</api>
