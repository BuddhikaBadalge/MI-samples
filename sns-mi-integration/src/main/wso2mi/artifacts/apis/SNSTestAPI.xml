<?xml version="1.0" encoding="UTF-8"?>
<api context="/sns" name="SNSTestAPI" xmlns="http://ws.apache.org/ns/synapse">

    <!--
        Credentials: Set AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY as
        environment variables in Choreo Config & Deploy. The AWS SDK
        DefaultCredentialsProvider picks them up automatically.

        Region and Topic ARN are configured as static class mediator
        properties below.
    -->

    <!-- Resource 1: POST /publish — static topic ARN -->
    <resource methods="POST" uri-template="/publish">
        <inSequence>
            <!-- Log AWS env variable availability -->
            <log level="custom">
                <property name="=== SNSTestAPI /publish ===" value="Checking AWS environment variables"/>
                <property name="AWS_ACCESS_KEY_ID" expression="get-property('env', 'AWS_ACCESS_KEY_ID')"/>
                <property name="AWS_SECRET_ACCESS_KEY_SET" expression="boolean(get-property('env', 'AWS_SECRET_ACCESS_KEY'))"/>
                <property name="aws.accessKeyId (system prop)" expression="get-property('system', 'aws.accessKeyId')"/>
                <property name="aws.secretAccessKey (system prop set)" expression="boolean(get-property('system', 'aws.secretAccessKey'))"/>
            </log>
            <property name="sns.messageGroupId" value="default-group" scope="default" type="STRING"/>
            <class name="org.wso2.custom.mediator.sns.SNSPublishMediator">
                <property name="region" value="eu-north-1"/>
                <property name="topicArn" value="arn:aws:sns:eu-north-1:567870626192:FIFO-MI.fifo"/>
            </class>
            <filter xpath="get-property('sns.status') = 'SUCCESS'">
                <then>
                    <payloadFactory media-type="json">
                        <format>{"status":"SUCCESS","messageId":"$1"}</format>
                        <args>
                            <arg evaluator="xml" expression="get-property('sns.messageId')"/>
                        </args>
                    </payloadFactory>
                    <respond/>
                </then>
                <else>
                    <payloadFactory media-type="json">
                        <format>{"status":"FAILURE","error":"$1"}</format>
                        <args>
                            <arg evaluator="xml" expression="get-property('sns.error')"/>
                        </args>
                    </payloadFactory>
                    <property name="HTTP_SC" scope="axis2" value="500"/>
                    <respond/>
                </else>
            </filter>
        </inSequence>
        <faultSequence>
            <payloadFactory media-type="json">
                <format>{"status":"ERROR","error":"Internal server error"}</format>
            </payloadFactory>
            <property name="HTTP_SC" scope="axis2" value="500"/>
            <respond/>
        </faultSequence>
    </resource>

    <!-- Resource 2: POST /publish-dynamic?topicArn={arn}&messageGroupId={id} — dynamic topic ARN -->
    <resource methods="POST" uri-template="/publish-dynamic">
        <inSequence>
            <!-- Log AWS env variable availability -->
            <log level="custom">
                <property name="=== SNSTestAPI /publish-dynamic ===" value="Checking AWS environment variables"/>
                <property name="AWS_ACCESS_KEY_ID" expression="get-property('env', 'AWS_ACCESS_KEY_ID')"/>
                <property name="AWS_SECRET_ACCESS_KEY_SET" expression="boolean(get-property('env', 'AWS_SECRET_ACCESS_KEY'))"/>
                <property name="aws.accessKeyId (system prop)" expression="get-property('system', 'aws.accessKeyId')"/>
                <property name="aws.secretAccessKey (system prop set)" expression="boolean(get-property('system', 'aws.secretAccessKey'))"/>
            </log>
            <!-- Topic ARN and message group ID from query parameters -->
            <property expression="$url:topicArn" name="sns.topicArn" scope="default" type="STRING"/>
            <property expression="$url:messageGroupId" name="sns.messageGroupId" scope="default" type="STRING"/>
            <class name="org.wso2.custom.mediator.sns.SNSPublishMediator">
                <property name="region" value="eu-north-1"/>
            </class>
            <filter xpath="get-property('sns.status') = 'SUCCESS'">
                <then>
                    <payloadFactory media-type="json">
                        <format>{"status":"SUCCESS","messageId":"$1"}</format>
                        <args>
                            <arg evaluator="xml" expression="get-property('sns.messageId')"/>
                        </args>
                    </payloadFactory>
                    <respond/>
                </then>
                <else>
                    <payloadFactory media-type="json">
                        <format>{"status":"FAILURE","error":"$1"}</format>
                        <args>
                            <arg evaluator="xml" expression="get-property('sns.error')"/>
                        </args>
                    </payloadFactory>
                    <property name="HTTP_SC" scope="axis2" value="500"/>
                    <respond/>
                </else>
            </filter>
        </inSequence>
        <faultSequence>
            <payloadFactory media-type="json">
                <format>{"status":"ERROR","error":"Internal server error"}</format>
            </payloadFactory>
            <property name="HTTP_SC" scope="axis2" value="500"/>
            <respond/>
        </faultSequence>
    </resource>

</api>
