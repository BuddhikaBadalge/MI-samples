<?xml version="1.0" encoding="UTF-8"?>
<api context="/sns" name="SNSTestAPI" xmlns="http://ws.apache.org/ns/synapse">

    <!--
        Credentials and config are read from Choreo environment variables:
          sns_access_key_id, sns_secret_access_key, sns_region, sns_topic_arn
        They are set as message-context properties that the class mediator picks up.
    -->

    <!-- Resource 1: POST /publish — static topic ARN -->
    <resource methods="POST" uri-template="/publish">
        <inSequence>
            <!-- Read Choreo env vars and set as properties the mediator expects -->
            <property name="sns.accessKeyId" expression="get-property('env', 'sns_access_key_id')" scope="default" type="STRING"/>
            <property name="sns.secretAccessKey" expression="get-property('env', 'sns_secret_access_key')" scope="default" type="STRING"/>
            <property name="sns.region" expression="get-property('env', 'sns_region')" scope="default" type="STRING"/>
            <property name="sns.topicArn" expression="get-property('env', 'sns_topic_arn')" scope="default" type="STRING"/>
            <property name="sns.messageGroupId" value="default-group" scope="default" type="STRING"/>
            <!-- Log resolved properties -->
            <log level="custom">
                <property name="=== SNSTestAPI /publish ===" value="Properties set from env"/>
                <property name="sns.accessKeyId SET" expression="boolean(get-property('sns.accessKeyId'))"/>
                <property name="sns.secretAccessKey SET" expression="boolean(get-property('sns.secretAccessKey'))"/>
                <property name="sns.region" expression="get-property('sns.region')"/>
                <property name="sns.topicArn" expression="get-property('sns.topicArn')"/>
            </log>
            <class name="org.wso2.custom.mediator.sns.SNSPublishMediator">
                <property name="region" value="eu-north-1"/>
                <property name="topicArn" value="arn:aws:sns:eu-north-1:567870626192:FIFO-MI.fifo"/>
            </class>
            <filter xpath="get-property('sns.status') = 'SUCCESS'">
                <then>
                    <payloadFactory media-type="json">
                        <format>{"status":"SUCCESS","messageId":"$1"}</format>
                        <args>
                            <arg evaluator="xml" expression="get-property('sns.messageId')"/>
                        </args>
                    </payloadFactory>
                    <respond/>
                </then>
                <else>
                    <payloadFactory media-type="json">
                        <format>{"status":"FAILURE","error":"$1"}</format>
                        <args>
                            <arg evaluator="xml" expression="get-property('sns.error')"/>
                        </args>
                    </payloadFactory>
                    <property name="HTTP_SC" scope="axis2" value="500"/>
                    <respond/>
                </else>
            </filter>
        </inSequence>
        <faultSequence>
            <payloadFactory media-type="json">
                <format>{"status":"ERROR","error":"Internal server error"}</format>
            </payloadFactory>
            <property name="HTTP_SC" scope="axis2" value="500"/>
            <respond/>
        </faultSequence>
    </resource>

    <!-- Resource 2: POST /publish-dynamic?topicArn={arn}&messageGroupId={id} — dynamic topic ARN -->
    <resource methods="POST" uri-template="/publish-dynamic">
        <inSequence>
            <!-- Read Choreo env vars and set as properties the mediator expects -->
            <property name="sns.accessKeyId" expression="get-property('env', 'sns_access_key_id')" scope="default" type="STRING"/>
            <property name="sns.secretAccessKey" expression="get-property('env', 'sns_secret_access_key')" scope="default" type="STRING"/>
            <property name="sns.region" expression="get-property('env', 'sns_region')" scope="default" type="STRING"/>
            <!-- Topic ARN and message group ID from query parameters (override env) -->
            <property expression="$url:topicArn" name="sns.topicArn" scope="default" type="STRING"/>
            <property expression="$url:messageGroupId" name="sns.messageGroupId" scope="default" type="STRING"/>
            <!-- Log resolved properties -->
            <log level="custom">
                <property name="=== SNSTestAPI /publish-dynamic ===" value="Properties set from env"/>
                <property name="sns.accessKeyId SET" expression="boolean(get-property('sns.accessKeyId'))"/>
                <property name="sns.secretAccessKey SET" expression="boolean(get-property('sns.secretAccessKey'))"/>
                <property name="sns.region" expression="get-property('sns.region')"/>
                <property name="sns.topicArn" expression="get-property('sns.topicArn')"/>
            </log>
            <class name="org.wso2.custom.mediator.sns.SNSPublishMediator">
                <property name="region" value="eu-north-1"/>
            </class>
            <filter xpath="get-property('sns.status') = 'SUCCESS'">
                <then>
                    <payloadFactory media-type="json">
                        <format>{"status":"SUCCESS","messageId":"$1"}</format>
                        <args>
                            <arg evaluator="xml" expression="get-property('sns.messageId')"/>
                        </args>
                    </payloadFactory>
                    <respond/>
                </then>
                <else>
                    <payloadFactory media-type="json">
                        <format>{"status":"FAILURE","error":"$1"}</format>
                        <args>
                            <arg evaluator="xml" expression="get-property('sns.error')"/>
                        </args>
                    </payloadFactory>
                    <property name="HTTP_SC" scope="axis2" value="500"/>
                    <respond/>
                </else>
            </filter>
        </inSequence>
        <faultSequence>
            <payloadFactory media-type="json">
                <format>{"status":"ERROR","error":"Internal server error"}</format>
            </payloadFactory>
            <property name="HTTP_SC" scope="axis2" value="500"/>
            <respond/>
        </faultSequence>
    </resource>

</api>
