<?xml version="1.0" encoding="UTF-8"?>
<api context="/sns" name="SNSTestAPI" xmlns="http://ws.apache.org/ns/synapse">

    <!--
        Configuration is read from WSO2 Secure Vault / Choreo ConfigMaps+Secrets.
        Define the following keys in your vault before deploying:

          sns_region             — AWS region, e.g. eu-north-1
          sns_topic_arn          — Full SNS topic ARN
          aws_access_key_id      — IAM access key ID
          aws_secret_access_key  — IAM secret access key
                                   (leave both credential keys empty to use the
                                    AWS Default Credentials Provider Chain instead)

        For local MI pack testing without Secure Vault, add region/topicArn/credentials
        directly as <property> elements inside the <class> mediator block.
        See the Synapse Properties Reference in the README for details.
    -->

    <!-- Resource 1: POST /publish — topic ARN from vault -->
    <resource methods="POST" uri-template="/publish">
        <inSequence>
            <!-- Read all configuration from Secure Vault / Choreo secrets -->
            <propertyGroup>
                <property expression="wso2:vault-lookup('sns_region')" name="sns.region" scope="default" type="STRING"/>
                <property expression="wso2:vault-lookup('sns_topic_arn')" name="sns.topicArn" scope="default" type="STRING"/>
                <property expression="wso2:vault-lookup('aws_access_key_id')" name="sns.accessKeyId" scope="default" type="STRING"/>
                <property expression="wso2:vault-lookup('aws_secret_access_key')" name="sns.secretAccessKey" scope="default" type="STRING"/>
                <!-- Required for FIFO topics -->
                <property name="sns.messageGroupId" value="default-group" scope="default" type="STRING"/>
            </propertyGroup>
            <class name="org.wso2.custom.mediator.sns.SNSPublishMediator"/>
            <filter xpath="get-property('sns.status') = 'SUCCESS'">
                <then>
                    <payloadFactory media-type="json">
                        <format>{"status":"SUCCESS","messageId":"$1"}</format>
                        <args>
                            <arg evaluator="xml" expression="get-property('sns.messageId')"/>
                        </args>
                    </payloadFactory>
                    <respond/>
                </then>
                <else>
                    <payloadFactory media-type="json">
                        <format>{"status":"FAILURE","error":"$1"}</format>
                        <args>
                            <arg evaluator="xml" expression="get-property('sns.error')"/>
                        </args>
                    </payloadFactory>
                    <property name="HTTP_SC" scope="axis2" value="500"/>
                    <respond/>
                </else>
            </filter>
        </inSequence>
        <faultSequence>
            <payloadFactory media-type="json">
                <format>{"status":"ERROR","error":"Internal server error"}</format>
            </payloadFactory>
            <property name="HTTP_SC" scope="axis2" value="500"/>
            <respond/>
        </faultSequence>
    </resource>

    <!-- Resource 2: POST /publish-dynamic?topicArn={arn}&messageGroupId={id} — dynamic topic ARN -->
    <resource methods="POST" uri-template="/publish-dynamic">
        <inSequence>
            <!-- Region and credentials from Secure Vault / Choreo secrets -->
            <propertyGroup>
                <property expression="wso2:vault-lookup('sns_region')" name="sns.region" scope="default" type="STRING"/>
                <property expression="wso2:vault-lookup('aws_access_key_id')" name="sns.accessKeyId" scope="default" type="STRING"/>
                <property expression="wso2:vault-lookup('aws_secret_access_key')" name="sns.secretAccessKey" scope="default" type="STRING"/>
            </propertyGroup>
            <!-- Topic ARN and message group ID from query parameters -->
            <property expression="$url:topicArn" name="sns.topicArn" scope="default" type="STRING"/>
            <property expression="$url:messageGroupId" name="sns.messageGroupId" scope="default" type="STRING"/>
            <class name="org.wso2.custom.mediator.sns.SNSPublishMediator"/>
            <filter xpath="get-property('sns.status') = 'SUCCESS'">
                <then>
                    <payloadFactory media-type="json">
                        <format>{"status":"SUCCESS","messageId":"$1"}</format>
                        <args>
                            <arg evaluator="xml" expression="get-property('sns.messageId')"/>
                        </args>
                    </payloadFactory>
                    <respond/>
                </then>
                <else>
                    <payloadFactory media-type="json">
                        <format>{"status":"FAILURE","error":"$1"}</format>
                        <args>
                            <arg evaluator="xml" expression="get-property('sns.error')"/>
                        </args>
                    </payloadFactory>
                    <property name="HTTP_SC" scope="axis2" value="500"/>
                    <respond/>
                </else>
            </filter>
        </inSequence>
        <faultSequence>
            <payloadFactory media-type="json">
                <format>{"status":"ERROR","error":"Internal server error"}</format>
            </payloadFactory>
            <property name="HTTP_SC" scope="axis2" value="500"/>
            <respond/>
        </faultSequence>
    </resource>

</api>
