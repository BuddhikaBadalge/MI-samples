<?xml version="1.0" encoding="UTF-8"?>
<api context="/sns" name="SNSTestAPI" xmlns="http://ws.apache.org/ns/synapse">

    <!--
        Credentials are intentionally omitted from this file.
        The mediator falls back to the AWS Default Credentials Provider Chain:
          - Choreo / container: set AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY as environment variables
          - Local dev: configure ~/.aws/credentials or use an IAM instance role

        Replace YOUR_AWS_REGION and YOUR_SNS_TOPIC_ARN with your actual values.
    -->

    <!-- Resource 1: POST /publish — static topicArn config -->
    <resource methods="POST" uri-template="/publish">
        <inSequence>
            <!-- Required for FIFO topics -->
            <property name="sns.messageGroupId" value="default-group" scope="default" type="STRING"/>
            <class name="org.wso2.custom.mediator.sns.SNSPublishMediator">
                <property name="region" value="YOUR_AWS_REGION"/>
                <property name="topicArn" value="YOUR_SNS_TOPIC_ARN"/>
                <property name="accessKeyId" value=""/>
                <property name="secretAccessKey" value=""/>
            </class>
            <filter xpath="get-property('sns.status') = 'SUCCESS'">
                <then>
                    <payloadFactory media-type="json">
                        <format>{"status":"SUCCESS","messageId":"$1"}</format>
                        <args>
                            <arg evaluator="xml" expression="get-property('sns.messageId')"/>
                        </args>
                    </payloadFactory>
                    <respond/>
                </then>
                <else>
                    <payloadFactory media-type="json">
                        <format>{"status":"FAILURE","error":"$1"}</format>
                        <args>
                            <arg evaluator="xml" expression="get-property('sns.error')"/>
                        </args>
                    </payloadFactory>
                    <property name="HTTP_SC" scope="axis2" value="500"/>
                    <respond/>
                </else>
            </filter>
        </inSequence>
        <faultSequence>
            <payloadFactory media-type="json">
                <format>{"status":"ERROR","error":"Internal server error"}</format>
            </payloadFactory>
            <property name="HTTP_SC" scope="axis2" value="500"/>
            <respond/>
        </faultSequence>
    </resource>

    <!-- Resource 2: POST /publish-dynamic?topicArn={arn}&messageGroupId={id} — dynamic topicArn -->
    <resource methods="POST" uri-template="/publish-dynamic">
        <inSequence>
            <property expression="$url:topicArn" name="sns.topicArn" scope="default" type="STRING"/>
            <property expression="$url:messageGroupId" name="sns.messageGroupId" scope="default" type="STRING"/>
            <class name="org.wso2.custom.mediator.sns.SNSPublishMediator">
                <property name="region" value="YOUR_AWS_REGION"/>
                <property name="accessKeyId" value=""/>
                <property name="secretAccessKey" value=""/>
            </class>
            <filter xpath="get-property('sns.status') = 'SUCCESS'">
                <then>
                    <payloadFactory media-type="json">
                        <format>{"status":"SUCCESS","messageId":"$1"}</format>
                        <args>
                            <arg evaluator="xml" expression="get-property('sns.messageId')"/>
                        </args>
                    </payloadFactory>
                    <respond/>
                </then>
                <else>
                    <payloadFactory media-type="json">
                        <format>{"status":"FAILURE","error":"$1"}</format>
                        <args>
                            <arg evaluator="xml" expression="get-property('sns.error')"/>
                        </args>
                    </payloadFactory>
                    <property name="HTTP_SC" scope="axis2" value="500"/>
                    <respond/>
                </else>
            </filter>
        </inSequence>
        <faultSequence>
            <payloadFactory media-type="json">
                <format>{"status":"ERROR","error":"Internal server error"}</format>
            </payloadFactory>
            <property name="HTTP_SC" scope="axis2" value="500"/>
            <respond/>
        </faultSequence>
    </resource>

</api>
